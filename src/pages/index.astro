---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Tomás Cáceres — Inicio & Proyectos"
  description="Portfolio de Tomás Cáceres: Estudiante de Ingeniería Informática, Machine Learning, Data Science y desarrollo con agentes de IA."
>
  <!-- Top Retro Window Menu Bar -->
  <header class="border-b border-zinc-800 bg-zinc-900/90 sticky top-0 z-40 backdrop-blur-sm">
    <div class="max-w-4xl mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-3 font-mono text-xs">
      <div class="flex items-center gap-2">
        <span class="inline-block w-3 h-3 bg-emerald-500 rounded-full animate-pulse"></span>
        <a href="/" class="font-bold text-zinc-100 hover:text-amber-400 transition-colors">
          tomas@caceres:~$
        </a>
      </div>
      <nav class="flex items-center gap-2 sm:gap-3">
        <a
          href="/"
          class="px-2.5 py-1 text-zinc-100 bg-zinc-800 border-t border-l border-zinc-600 border-b border-r border-zinc-950 shadow-sm font-semibold hover:bg-zinc-700 transition-colors"
        >
          [ Inicio ]
        </a>
        <a
          href="/universidad"
          class="px-2.5 py-1 text-zinc-400 hover:text-zinc-100 bg-zinc-900/80 border border-zinc-800 hover:border-zinc-700 transition-colors"
        >
          /universidad
        </a>
        <a
          href="/sobre-mi"
          class="px-2.5 py-1 text-zinc-400 hover:text-zinc-100 bg-zinc-900/80 border border-zinc-800 hover:border-zinc-700 transition-colors"
        >
          /sobre-mi
        </a>
        <a
          href="https://github.com/TomasCaceresIO"
          target="_blank"
          rel="noopener noreferrer"
          class="px-2.5 py-1 text-zinc-400 hover:text-zinc-100 bg-zinc-900/80 border border-zinc-800 hover:border-zinc-700 transition-colors hidden sm:inline-flex items-center gap-1"
        >
          GitHub ↗
        </a>
      </nav>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-8 sm:py-12 space-y-12">
    <!-- Hero Section -->
    <section class="retro-window p-6 sm:p-8 bg-zinc-900/90 border-2 border-zinc-700 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.8)]">
      <div class="window-titlebar mb-6 px-3 py-1.5 bg-gradient-to-r from-zinc-800 to-zinc-700 border border-zinc-600 flex items-center justify-between text-xs font-mono text-zinc-200">
        <span class="flex items-center gap-2">
          <span class="text-amber-400">💾</span> user_profile.nfo
        </span>
        <div class="flex items-center gap-1.5 opacity-80">
          <span class="w-3 h-3 inline-block bg-zinc-600 border border-zinc-400 text-[9px] leading-none text-center font-bold">_</span>
          <span class="w-3 h-3 inline-block bg-zinc-600 border border-zinc-400 text-[9px] leading-none text-center font-bold">□</span>
          <span class="w-3 h-3 inline-block bg-red-800/80 border border-red-500 text-[9px] leading-none text-center font-bold">×</span>
        </div>
      </div>

      <div class="space-y-4">
        <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-zinc-50">
          Hola, soy Tomás
        </h1>

        <p class="text-base sm:text-lg text-zinc-300 leading-relaxed font-sans">
          Estudiante de <strong class="text-zinc-100 font-semibold">Ingeniería Informática</strong> enfocado en <span class="text-amber-400 font-mono text-sm sm:text-base">Machine Learning</span> y <span class="text-amber-400 font-mono text-sm sm:text-base">Data Science</span>, apasionado por trastear con datos, orquestar agentes y construir utilidades reales sin complicarse la vida.
        </p>

        <div class="pt-2 flex flex-wrap gap-2 text-xs font-mono">
          <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400">
            📍 Madrid, España
          </span>
          <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400">
            🤖 Agent Orchestration
          </span>
          <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400">
            🔒 Local-First
          </span>
          <span class="px-2.5 py-1 bg-zinc-950 border border-zinc-800 text-zinc-400">
            📊 Data Science & ML
          </span>
        </div>
      </div>
    </section>

    <!-- Featured Project: ActivityUI -->
    <section class="retro-window p-6 sm:p-8 bg-zinc-900/90 border-2 border-zinc-700 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.8)]">
      <div class="window-titlebar mb-6 px-3 py-1.5 bg-gradient-to-r from-blue-950 to-zinc-800 border border-blue-800/60 flex items-center justify-between text-xs font-mono text-blue-200">
        <span class="flex items-center gap-2">
          <span>⚡</span> featured_project: activityUI.exe
        </span>
        <span class="text-[11px] text-blue-300 font-mono">v1.0.0 [STABLE]</span>
      </div>

      <div class="space-y-6">
        <div>
          <div class="flex flex-wrap items-baseline gap-3">
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-zinc-50">
              ActivityUI
            </h2>
            <span class="font-mono text-xs text-amber-400 bg-amber-950/50 border border-amber-800 px-2 py-0.5">
              Local-First Time Intelligence
            </span>
          </div>
          <p class="mt-3 text-base text-zinc-300 leading-relaxed">
            Una aplicación de escritorio pensada para saber en qué se va exactamente el tiempo frente al ordenador 
            sin enviar nada a servidores externos ni comprometer la privacidad. Todo se procesa y almacena en local, 
            construida íntegramente orquestando agentes de IA en paralelo para diseñar, prototipar y refinar cada módulo.
          </p>
        </div>

        <!-- Technical Highlights -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 font-mono text-xs">
          <div class="p-3 bg-zinc-950/70 border border-zinc-800">
            <div class="text-zinc-400 font-bold mb-1">🔒 100% Privado</div>
            <div class="text-zinc-400">Sin telemetría, sin cuentas, base de datos local SQLite.</div>
          </div>
          <div class="p-3 bg-zinc-950/70 border border-zinc-800">
            <div class="text-zinc-400 font-bold mb-1">🤖 Agentic Built</div>
            <div class="text-zinc-400">Desarrollo acelerado orquestando múltiples agentes autónomos.</div>
          </div>
          <div class="p-3 bg-zinc-950/70 border border-zinc-800">
            <div class="text-zinc-400 font-bold mb-1">⚡ Ligero & Rápido</div>
            <div class="text-zinc-400">Monitorización pasiva eficiente en segundo plano.</div>
          </div>
        </div>

        <!-- Retro 3D Beveled Buttons (Win95 / Netscape style) -->
        <div class="pt-2">
          <div class="text-xs font-mono text-zinc-400 mb-3 uppercase tracking-wider">
            [ Acceso directo al proyecto ]
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <a
              href="https://14tomass.github.io/activityUI/"
              target="_blank"
              rel="noopener noreferrer"
              class="retro-btn text-zinc-900 bg-zinc-200 font-mono text-xs sm:text-sm font-bold px-4 py-2 flex items-center gap-2"
            >
              <span>🌐</span>
              <span>Visitar Landing</span>
              <span class="text-zinc-600">↗</span>
            </a>

            <a
              href="https://github.com/14tomass/activityUI"
              target="_blank"
              rel="noopener noreferrer"
              class="retro-btn text-zinc-900 bg-zinc-200 font-mono text-xs sm:text-sm font-bold px-4 py-2 flex items-center gap-2"
            >
              <span>📂</span>
              <span>Ver Repositorio</span>
              <span class="text-zinc-600">↗</span>
            </a>

            <a
              href="https://github.com/14tomass/activityUI/releases/latest"
              target="_blank"
              rel="noopener noreferrer"
              class="retro-btn text-zinc-900 bg-zinc-200 font-mono text-xs sm:text-sm font-bold px-4 py-2 flex items-center gap-2"
            >
              <span>💾</span>
              <span>Descargar Releases</span>
              <span class="text-zinc-600">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Under Construction / En Obras Vintage Block -->
    <section class="retro-window p-6 bg-zinc-900/90 border-2 border-zinc-700 shadow-[4px_4px_0px_0px_rgba(0,0,0,0.8)]">
      <!-- Vintage Caution Tape Header -->
      <div class="hazard-stripe py-2 px-4 mb-6 border border-amber-500/50 shadow-inner flex items-center justify-between font-mono font-bold text-xs sm:text-sm text-zinc-950 uppercase tracking-widest select-none">
        <span>🚧 WORK IN PROGRESS</span>
        <span class="hidden sm:inline">⚠️ EN OBRAS ⚠️</span>
        <span>🚧 LAB ZONE</span>
      </div>

      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="text-2xl sm:text-3xl">🧪</div>
          <div>
            <h3 class="font-serif text-xl sm:text-2xl font-bold text-zinc-100">
              Laboratorio de Machine Learning & Data Science
            </h3>
            <p class="font-mono text-xs text-amber-400">
              [ status: entrenando modelos & organizando datasets ]
            </p>
          </div>
        </div>

        <p class="text-sm sm:text-base text-zinc-300 leading-relaxed">
          Este espacio está reservado para futuros modelos predictivos, pipelines de visualización de datos, 
          notebooks reproducibles y experimentos con arquitecturas de agentes autónomos.
        </p>

        <div class="border border-dashed border-zinc-700 bg-zinc-950/60 p-4 font-mono text-xs text-zinc-400 space-y-2">
          <div class="flex items-center gap-2 text-zinc-300">
            <span class="text-amber-500">&gt;</span> Proyectos en cola de procesamiento:
          </div>
          <ul class="list-disc list-inside space-y-1 text-zinc-400 ml-2">
            <li>Modelos de predicción y análisis estadístico aplicados a datos reales.</li>
            <li>Pipelines de orquestación multi-agente con ejecución y memoria local.</li>
            <li>Recursos, apuntes y casos prácticos de Ingeniería Informática.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Internal Navigation Suggestions -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a
        href="/universidad"
        class="retro-window p-5 bg-zinc-900/80 border-2 border-zinc-700 hover:border-zinc-500 transition-colors shadow-[3px_3px_0px_0px_rgba(0,0,0,0.8)] group block"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono text-xs text-amber-400">[ Directorio ]</span>
          <span class="font-mono text-xs text-zinc-400 group-hover:text-zinc-100 transition-colors">ir ➔</span>
        </div>
        <h4 class="font-serif text-lg font-bold text-zinc-100 group-hover:text-amber-300 transition-colors">
          🎓 /universidad
        </h4>
        <p class="mt-1 text-xs text-zinc-400 leading-normal">
          Apuntes, proyectos académicos, asignaturas y código desarrollado durante el grado de Ingeniería Informática.
        </p>
      </a>

      <a
        href="/sobre-mi"
        class="retro-window p-5 bg-zinc-900/80 border-2 border-zinc-700 hover:border-zinc-500 transition-colors shadow-[3px_3px_0px_0px_rgba(0,0,0,0.8)] group block"
      >
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono text-xs text-amber-400">[ Perfil ]</span>
          <span class="font-mono text-xs text-zinc-400 group-hover:text-zinc-100 transition-colors">ir ➔</span>
        </div>
        <h4 class="font-serif text-lg font-bold text-zinc-100 group-hover:text-amber-300 transition-colors">
          👤 /sobre-mi
        </h4>
        <p class="mt-1 text-xs text-zinc-400 leading-normal">
          Filosofía de trabajo, trayectoria, enfoque hacia el software local-first y formas de contacto directo.
        </p>
      </a>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-zinc-800 bg-zinc-950 py-8 mt-12 text-center text-xs font-mono text-zinc-400">
    <div class="max-w-4xl mx-auto px-4 space-y-2">
      <p>Tomás Cáceres © {new Date().getFullYear()} — Diseñado con inspiración vintage &amp; minimalismo.</p>
      <p class="text-zinc-400">Compilado con Astro &amp; Tailwind CSS. Sin rastreadores ni cookies.</p>
    </div>
  </footer>
</Layout>

<style>
  /* Retro 3D Beveled Buttons (Win95 / Netscape 90s aesthetic) */
  .retro-btn {
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #27272a;
    border-bottom: 2px solid #27272a;
    box-shadow: 2px 2px 0px 0px rgba(0, 0, 0, 0.9);
    cursor: pointer;
    user-select: none;
    transition: transform 0.05s ease, box-shadow 0.05s ease;
    text-decoration: none;
  }

  .retro-btn:hover {
    background-color: #f4f4f5;
  }

  .retro-btn:active {
    border-top: 2px solid #27272a;
    border-left: 2px solid #27272a;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow: none;
    transform: translate(2px, 2px);
  }

  /* Retro Hazard warning stripes banner */
  .hazard-stripe {
    background: repeating-linear-gradient(
      -45deg,
      #f59e0b,
      #f59e0b 16px,
      #18181b 16px,
      #18181b 32px
    );
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0,0,0,0.9), 0 0 4px #000000;
  }

  /* Retro window styling */
  .retro-window {
    border-top-color: #52525b;
    border-left-color: #52525b;
    border-right-color: #18181b;
    border-bottom-color: #18181b;
  }
</style>
