---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Universidad & Formación | Tomás Cáceres"
  description="Trayectoria académica de Tomás Cáceres: Grado en Ingeniería Informática en la USAL, aprendizajes, experiencia universitaria y compañeros de carrera."
>
  <!-- Background retro grid / workspace -->
  <div class="min-h-screen bg-[#008080] text-zinc-900 font-mono py-6 px-3 sm:px-6 selection:bg-[#000080] selection:text-white">
    
    <!-- Top System Nav / Bar -->
    <header class="max-w-4xl mx-auto mb-6 bg-[#c0c0c0] p-1 border-2 border-t-white border-l-white border-r-[#404040] border-b-[#404040] shadow-md">
      <div class="bg-gradient-to-r from-[#000080] to-[#1084d0] text-white px-3 py-1 flex items-center justify-between text-xs font-bold tracking-wide">
        <div class="flex items-center gap-2">
          <span>📁</span>
          <span>C:\ACADEMIA\UNIVERSIDAD_EXPEDIENTE.EXE</span>
        </div>
        <div class="flex items-center gap-1">
          <button class="w-4 h-4 bg-[#c0c0c0] text-black text-[10px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none cursor-default">_</button>
          <button class="w-4 h-4 bg-[#c0c0c0] text-black text-[10px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none cursor-default">□</button>
          <a href="/" class="w-4 h-4 bg-[#c0c0c0] text-black text-[10px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none hover:bg-red-200">✕</a>
        </div>
      </div>
      <!-- Menu bar -->
      <div class="flex flex-wrap gap-4 px-2 py-1 text-xs border-b border-[#808080] text-zinc-800 bg-[#c0c0c0]">
        <a href="/" class="hover:bg-[#000080] hover:text-white px-1.5 py-0.5 transition-colors"><u>I</u>nicio</a>
        <a href="/universidad" class="bg-[#000080] text-white px-1.5 py-0.5"><u>U</u>niversidad</a>
        <a href="/sobre-mi" class="hover:bg-[#000080] hover:text-white px-1.5 py-0.5 transition-colors"><u>S</u>obre Mí</a>
        <span class="text-zinc-500">|</span>
        <span class="text-zinc-600">Estado: 3.er año (5.º semestre)</span>
      </div>
    </header>

    <!-- Main Window Container -->
    <main class="max-w-4xl mx-auto space-y-6">
      
      <!-- 1. Ventana Principal: Ficha Académica -->
      <section class="bg-[#c0c0c0] p-1.5 border-2 border-t-white border-l-white border-r-[#404040] border-b-[#404040] shadow-xl">
        <div class="bg-gradient-to-r from-[#000080] to-[#1084d0] text-white px-3 py-1 flex items-center justify-between text-xs font-bold">
          <div class="flex items-center gap-2">
            <span>🎓</span>
            <span>FICHA ACADÉMICA // GRADO EN INGENIERÍA INFORMÁTICA</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[11px] font-normal opacity-90 hidden sm:inline">[v3.0.26_ACTIVO]</span>
            <div class="flex items-center gap-1">
              <span class="w-3.5 h-3.5 bg-[#c0c0c0] text-black text-[9px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none">_</span>
              <span class="w-3.5 h-3.5 bg-[#c0c0c0] text-black text-[9px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none">□</span>
              <span class="w-3.5 h-3.5 bg-[#c0c0c0] text-black text-[9px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none">✕</span>
            </div>
          </div>
        </div>

        <div class="p-4 sm:p-6 bg-[#fbf8f1] border-2 border-t-[#808080] border-l-[#808080] border-r-white border-b-white mt-1 space-y-5 text-sm sm:text-base leading-relaxed text-zinc-900 font-serif">
          
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between border-b-2 border-[#808080] pb-3 gap-2 font-mono">
            <div>
              <h1 class="text-xl sm:text-2xl font-bold font-serif text-black">Grado en Ingeniería Informática</h1>
              <p class="text-xs text-zinc-600 mt-0.5">Cursando actualmente: <strong class="text-zinc-900">3.er año (5.º semestre)</strong></p>
            </div>
            <div class="inline-flex items-center gap-2 text-xs bg-[#e8e4d9] px-3 py-1 border border-[#808080]">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
              <span class="font-semibold text-zinc-800">Modo: Estudiante & Builder</span>
            </div>
          </div>

          <!-- Sincere University Copy (Word by word) -->
          <div class="space-y-4 font-serif text-zinc-900 text-sm sm:text-base leading-relaxed">
            <p class="first-letter:text-4xl first-letter:font-bold first-letter:float-left first-letter:mr-2 first-letter:text-[#000080]">
              Siendo totalmente sincero, a pesar de estar cursando actualmente la carrera no siento que esté aprendiendo mucho. Sin embargo la carrera sí me ha ayudado a tener un razonamiento más lógico y aprender algunas cosas que supongo y espero que me llevarán a convertirme en un buen profesional de informático. He aprovechado además el estar en la universidad para poder ir haciendo algunos cursos en medio para complementar lo que me está enseñando la universidad. Sin embargo lo que más me ha gustado de la carrera, y no me da pena decirlo, es la gente con la que estoy conociendo. Al final, como reflexión personal, es lo que me va a hacer mejorar como persona y como programador: trabajar con la gente codo a codo y sufrir con ellos trabajos con plazos inalcanzables por cualquier humano, que no IA.
            </p>
          </div>

        </div>
      </section>

      <!-- 2. Nueva Ventana Retro: Galería con 2 Marcos Biselados -->
      <section class="bg-[#c0c0c0] p-1.5 border-2 border-t-white border-l-white border-r-[#404040] border-b-[#404040] shadow-xl">
        <div class="bg-gradient-to-r from-[#000080] to-[#1084d0] text-white px-3 py-1 flex items-center justify-between text-xs font-bold">
          <div class="flex items-center gap-2">
            <span>🖼️</span>
            <span>C:\ACADEMIA\RECUERDOS_CAMPUS.BMP</span>
          </div>
          <div class="flex items-center gap-1">
            <button class="w-4 h-4 bg-[#c0c0c0] text-black text-[10px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none cursor-default">_</button>
            <button class="w-4 h-4 bg-[#c0c0c0] text-black text-[10px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none cursor-default">□</button>
            <button class="w-4 h-4 bg-[#c0c0c0] text-black text-[10px] flex items-center justify-center border border-t-white border-l-white border-r-black border-b-black font-bold leading-none cursor-default">✕</button>
          </div>
        </div>

        <div class="p-4 sm:p-6 bg-[#fbf8f1] border-2 border-t-[#808080] border-l-[#808080] border-r-white border-b-white mt-1 space-y-4">
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Marco 1 -->
            <div class="bg-[#dfdfdf] p-3 border-2 border-t-white border-l-white border-r-[#404040] border-b-[#404040] shadow-md flex flex-col justify-between">
              <div class="bg-[#ffffff] p-2 border-2 border-t-[#808080] border-l-[#808080] border-r-white border-b-white">
                <div class="relative min-h-[14rem] sm:min-h-[18rem] bg-[#e8e4d9] border border-[#808080] flex items-center justify-center overflow-hidden">
                  <img
                    src="/images/universidad-1.jpg"
                    alt="Recuerdo Campus Universidad 1"
                    class="w-full h-56 sm:h-72 object-cover block"
                    loading="lazy"
                    onerror="this.onerror=null; this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');"
                  />
                  <!-- Fallback retro si la imagen no carga -->
                  <div class="hidden absolute inset-0 flex flex-col items-center justify-center p-4 text-center text-zinc-600 font-mono text-xs">
                    <span class="text-3xl mb-1 select-none">🏛️</span>
                    <span class="font-bold text-black text-xs">IMG_CAMPUS_01</span>
                    <span class="text-[10px] text-zinc-500 mt-1">[ foto_01.bmp // 640x480 ]</span>
                    <div class="mt-2 text-[10px] text-zinc-600 bg-[#dfdfdf] px-2 py-0.5 border border-[#808080]">
                      Placeholder Visual
                    </div>
                  </div>
                </div>
              </div>
              <div class="pt-2 text-center font-mono text-xs text-zinc-800 font-bold">
                [foto_01.bmp]
              </div>
            </div>

            <!-- Marco 2 -->
            <div class="bg-[#dfdfdf] p-3 border-2 border-t-white border-l-white border-r-[#404040] border-b-[#404040] shadow-md flex flex-col justify-between">
              <div class="bg-[#ffffff] p-2 border-2 border-t-[#808080] border-l-[#808080] border-r-white border-b-white">
                <div class="relative min-h-[14rem] sm:min-h-[18rem] bg-[#e8e4d9] border border-[#808080] flex items-center justify-center overflow-hidden">
                  <img
                    src="/images/universidad-2.jpg"
                    alt="Recuerdo Campus Universidad 2"
                    class="w-full h-56 sm:h-72 object-cover block"
                    loading="lazy"
                    onerror="this.onerror=null; this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden');"
                  />
                  <!-- Fallback retro si la imagen no carga -->
                  <div class="hidden absolute inset-0 flex flex-col items-center justify-center p-4 text-center text-zinc-600 font-mono text-xs">
                    <span class="text-3xl mb-1 select-none">🏛️</span>
                    <span class="font-bold text-black text-xs">IMG_CAMPUS_02</span>
                    <span class="text-[10px] text-zinc-500 mt-1">[ foto_02.bmp // 640x480 ]</span>
                    <div class="mt-2 text-[10px] text-zinc-600 bg-[#dfdfdf] px-2 py-0.5 border border-[#808080]">
                      Placeholder Visual
                    </div>
                  </div>
                </div>
              </div>
              <div class="pt-2 text-center font-mono text-xs text-zinc-800 font-bold">
                [foto_02.bmp]
              </div>
            </div>

          </div>

          <!-- Internal navigation shortcuts -->
          <div class="pt-3 flex flex-wrap items-center justify-between gap-4 font-mono text-xs border-t border-[#808080]/30">
            <a href="/" class="inline-flex items-center gap-1 px-3 py-1.5 bg-[#c0c0c0] text-black border-2 border-t-white border-l-white border-r-[#404040] border-b-[#404040] hover:bg-[#d8d8d8] active:border-t-[#404040] active:border-l-[#404040] active:border-r-white active:border-b-white font-semibold">
              <span>←</span>
              <span>Volver a Inicio</span>
            </a>
            <a href="/sobre-mi" class="inline-flex items-center gap-1 px-3 py-1.5 bg-[#c0c0c0] text-black border-2 border-t-white border-l-white border-r-[#404040] border-b-[#404040] hover:bg-[#d8d8d8] active:border-t-[#404040] active:border-l-[#404040] active:border-r-white active:border-b-white font-semibold">
              <span>Ver Sobre Mí</span>
              <span>→</span>
            </a>
          </div>

        </div>
      </section>

      <!-- Status Bar at bottom -->
      <footer class="bg-[#c0c0c0] p-1 border-2 border-t-white border-l-white border-r-[#404040] border-b-[#404040] flex flex-wrap items-center justify-between text-xs text-zinc-700 font-mono gap-2">
        <div class="flex items-center gap-2 px-2 py-0.5 bg-[#dfdfdf] border border-t-[#808080] border-l-[#808080] border-r-white border-b-white">
          <span class="text-green-700">●</span>
          <span>ESTADO: 3.er AÑO (5.º SEMESTRE)</span>
        </div>
        <div class="flex items-center gap-3 px-2 py-0.5 bg-[#dfdfdf] border border-t-[#808080] border-l-[#808080] border-r-white border-b-white">
          <span>MEM: 640K OK</span>
          <span>GALERÍA: 2 FOTOS</span>
          <span>COD: UTF-8</span>
        </div>
      </footer>

    </main>
  </div>
</Layout>
