---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Tomás Cáceres — ML & Data Science Engineer',
  description =
    'Portfolio of Tomás Cáceres: Machine Learning Engineer, Data Scientist, and AI Pipeline Orchestrator building local-first data systems.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Tomás Cáceres" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 antialiased font-sans selection:bg-zinc-700 selection:text-white">
    <slot />
  </body>
</html>
