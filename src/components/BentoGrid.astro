---
import type { Project } from '../types/project';
import ProjectCard from './ProjectCard.astro';
import rawProjects from '../data/projects.json';

const projects = rawProjects as Project[];
const featuredProject = projects.find((p) => p.featured) || projects[0];
const otherProjects = projects.filter((p) => p.id !== featuredProject.id);
---

<section id="case-study" class="py-16 md:py-24 border-b border-zinc-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-xs font-mono text-zinc-400 mb-3">
        <span>Featured Case Study</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white">
        Arquitectura & Caso de Estudio Destacado
      </h2>
      <p class="text-base text-zinc-400 mt-2 max-w-2xl">
        Ingeniería aplicada a sistemas locales, procesamiento de series temporales y pipelines preparatorios para modelos de Machine Learning.
      </p>
    </div>

    <!-- Main Bento Hero Card: ActivityUI -->
    <div class="rounded-2xl bg-zinc-900/40 border border-zinc-800 p-6 md:p-10 mb-12 shadow-2xl relative overflow-hidden">
      <!-- Ambient backlighting -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-zinc-700/10 rounded-full blur-3xl pointer-events-none"></div>

      <!-- Header row of the card -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-8 border-b border-zinc-800/80">
        <div>
          <span class="text-xs font-mono text-emerald-400 uppercase tracking-wider block mb-1">
            {featuredProject.category} • v0.1 Production
          </span>
          <h3 class="text-2xl sm:text-4xl font-bold text-white">
            {featuredProject.title}
          </h3>
          <p class="text-sm sm:text-base font-mono text-zinc-400 mt-1">
            {featuredProject.subtitle}
          </p>
        </div>

        <!-- Metric Badges -->
        <div class="flex flex-wrap items-center gap-3">
          {featuredProject.metrics.map((m) => (
            <div class="px-4 py-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80">
              <span class="block text-[10px] text-zinc-400 uppercase tracking-widest font-mono">{m.label}</span>
              <span class="block text-base font-bold text-white font-mono">{m.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Case study deep dive: 4 technical pillars -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-8">
        <!-- 1. El Problema -->
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 font-semibold">01</span>
            <h4 class="text-base font-semibold text-white">El Problema</h4>
          </div>
          <p class="text-sm text-zinc-300 leading-relaxed">
            {featuredProject.problem}
          </p>
        </div>

        <!-- 2. Extracción y Procesamiento -->
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 font-semibold">02</span>
            <h4 class="text-base font-semibold text-white">Extracción y Procesamiento de Datos</h4>
          </div>
          <p class="text-sm text-zinc-300 leading-relaxed">
            {featuredProject.pipeline}
          </p>
        </div>

        <!-- 3. Arquitectura y Orquestación -->
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-zinc-800 text-zinc-300 font-semibold">03</span>
            <h4 class="text-base font-semibold text-white">Arquitectura & Orquestación Antigravity</h4>
          </div>
          <p class="text-sm text-zinc-300 leading-relaxed">
            {featuredProject.architecture}
          </p>
        </div>

        <!-- 4. Visión ML / Data Roadmap -->
        <div class="space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/50 font-semibold">04</span>
            <h4 class="text-base font-semibold text-white">Visión ML & Roadmap de Modelado</h4>
          </div>
          <p class="text-sm text-zinc-300 leading-relaxed">
            {featuredProject.mlRoadmap}
          </p>
        </div>
      </div>

      <!-- Action & Links Toolbar -->
      <div class="pt-6 border-t border-zinc-800 flex flex-wrap items-center justify-between gap-4">
        <!-- Tech Pills -->
        <div class="flex flex-wrap gap-2">
          {featuredProject.technologies.map((t) => (
            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-zinc-800/80 text-zinc-300 border border-zinc-700/60">
              {t}
            </span>
          ))}
        </div>

        <!-- Direct CTA buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="https://14tomass.github.io/activityUI/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-zinc-100 text-zinc-900 font-medium text-xs hover:bg-white transition-all shadow-sm"
          >
            <span>Landing Page</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>

          <a
            href="https://github.com/14tomass/activityUI"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-zinc-900 text-zinc-300 border border-zinc-700 text-xs font-mono hover:bg-zinc-800 hover:text-white transition-all"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span>Repositorio</span>
          </a>

          <a
            href="https://github.com/14tomass/activityUI/releases/latest"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-zinc-900 text-emerald-400 border border-emerald-900/60 text-xs font-mono hover:bg-emerald-950/40 transition-all"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
            <span>Descarga Releases (.exe / .zip)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Secondary Bento Grid for Other Projects / Pipelines -->
    {otherProjects.length > 0 && (
      <div>
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-xl font-bold text-white">
            Pipelines en Desarrollo & Roadmap ML
          </h3>
          <span class="text-xs font-mono text-zinc-400">
            {otherProjects.length} proyectos adicionales
          </span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {otherProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </div>
    )}
  </div>
</section>
