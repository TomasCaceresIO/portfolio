---
import type { Project } from '../types/project';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const statusStyles = {
  active: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  'in-progress': 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  roadmap: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
  completed: 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20',
};
---

<article class="group relative flex flex-col justify-between p-6 rounded-xl bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700 transition-all duration-300 hover:shadow-xl hover:shadow-black/40">
  <div>
    <!-- Header: Category & Status Badge -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <span class="text-xs font-mono uppercase tracking-wider text-zinc-400">
        {project.category}
      </span>
      <span class={`text-[11px] font-mono px-2 py-0.5 rounded-full border ${statusStyles[project.status]}`}>
        {project.status}
      </span>
    </div>

    <!-- Title & Subtitle -->
    <h3 class="text-xl font-bold text-white group-hover:text-zinc-100 transition-colors">
      {project.title}
    </h3>
    <p class="text-xs font-mono text-zinc-400 mt-1 mb-3">
      {project.subtitle}
    </p>

    <!-- Summary -->
    <p class="text-sm text-zinc-300 leading-relaxed mb-5">
      {project.summary}
    </p>

    <!-- Key Metrics Grid -->
    {project.metrics && project.metrics.length > 0 && (
      <div class="grid grid-cols-2 gap-2 my-4 p-3 rounded-lg bg-zinc-950/60 border border-zinc-800/50">
        {project.metrics.slice(0, 2).map((m) => (
          <div>
            <span class="block text-xs text-zinc-400 font-mono">{m.label}</span>
            <span class="block text-sm font-semibold text-white font-mono">{m.value}</span>
          </div>
        ))}
      </div>
    )}

    <!-- Technologies tags -->
    <div class="flex flex-wrap gap-1.5 my-4">
      {project.technologies.map((tech) => (
        <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-800/70 text-zinc-300 border border-zinc-700/50">
          {tech}
        </span>
      ))}
    </div>
  </div>

  <!-- Links -->
  {project.links && project.links.length > 0 && (
    <div class="pt-4 border-t border-zinc-800/60 flex flex-wrap items-center gap-3">
      {project.links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-300 hover:text-white transition-colors"
        >
          <span>{link.label}</span>
          <svg class="w-3.5 h-3.5 text-zinc-500 group-hover:text-zinc-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ))}
    </div>
  )}
</article>
